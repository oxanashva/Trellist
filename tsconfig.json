{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vitest/globals"], 
    "skipLibCheck": true,
    "noEmit": true, 
    "allowJs": true, 
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": ["src", "vite-env.d.ts"]
}